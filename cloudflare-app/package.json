{
  "name": "cloudflare-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wrangler": "wrangler pages dev --port 8787",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler pages deploy dist --commit-dirty=true",
    "deploy:staging": "npm run build && wrangler pages deploy dist --branch staging --commit-dirty=true",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "audio:metadata": "node scripts/audio-metadata.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "worker-timers": "^8.0.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^5.0.2"
  }
}
